#!/bin/bash
set -e

case "$1" in
    configure)
        # Create required directories
        mkdir -p /srv/shares
        chmod 755 /srv/shares
        
        mkdir -p /etc/samba/smb.conf.d
        chmod 755 /etc/samba/smb.conf.d
        
        mkdir -p /etc/exports.d
        chmod 755 /etc/exports.d
        
        mkdir -p /etc/avahi/services
        chmod 755 /etc/avahi/services
        
        # nosd keeps the shares in /etc/nos/shares.json (a missing file is an
        # empty list) and nos-agent writes them to one Samba include file and
        # one exports file. Samba's include doesn't expand globs, so the
        # include names the file. (Earlier versions added
        # "include = /etc/samba/smb.conf.d/*.conf", which Samba never read.)
        SMB_INCLUDE=/etc/samba/smb.conf.d/nos-shares.conf
        if [ ! -e "$SMB_INCLUDE" ]; then
            printf '# Managed by nOS (nos-agent). Changes here are overwritten.\n' > "$SMB_INCLUDE"
            chmod 644 "$SMB_INCLUDE"
        fi
        if [ ! -e /etc/exports.d/nos.exports ]; then
            printf '# Managed by nOS (nos-agent). Changes here are overwritten.\n' > /etc/exports.d/nos.exports
            chmod 644 /etc/exports.d/nos.exports
        fi
        if [ -f /etc/samba/smb.conf ]; then
            if grep -q '^[[:space:]]*include = /etc/samba/smb.conf.d/\*\.conf' /etc/samba/smb.conf; then
                sed -i "s|^\([[:space:]]*\)include = /etc/samba/smb.conf.d/\*\.conf|\1include = $SMB_INCLUDE|" /etc/samba/smb.conf
            elif ! grep -qF "include = $SMB_INCLUDE" /etc/samba/smb.conf; then
                printf '\n# nOS managed shares\n[global]\n    include = %s\n' "$SMB_INCLUDE" >> /etc/samba/smb.conf
            fi
        fi

        # Enable and start services
        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload || true
            
            # Enable services
            systemctl enable smbd.service || true
            systemctl enable nmbd.service || true
            systemctl enable nfs-server.service || true
            systemctl enable avahi-daemon.service || true
            
            # Start services if system is running
            if [ -f /run/systemd/system ]; then
                systemctl start smbd.service || true
                systemctl start nmbd.service || true
                systemctl start nfs-server.service || true
                systemctl start avahi-daemon.service || true
            fi
        fi
        
        # Apply firewall rules (idempotent)
        if [ -x /usr/share/nos-shares/setup-firewall.sh ]; then
            /usr/share/nos-shares/setup-firewall.sh || true
        fi
        ;;
        
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
        
    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
