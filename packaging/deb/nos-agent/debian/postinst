#!/bin/sh
set -e
case "$1" in
    configure)
        if command -v systemd-sysusers >/dev/null 2>&1; then
            systemd-sysusers || true
        fi
        systemctl daemon-reload || true
        systemctl enable nos-agent.service nos-firewall.service || true
        # In the ISO's chroot there is no running systemd; that's fine.
        systemctl restart nos-agent.service || true
        systemctl start nos-firewall.service || true
        ;;
esac
exit 0
