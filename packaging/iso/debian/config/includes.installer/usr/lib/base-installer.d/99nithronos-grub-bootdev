#!/bin/sh
# Install GRUB to the disk that holds the installed system.
#
# grub-installer's "default" boot device is the first disk, which on a NAS
# with several drives is often a data disk (device order isn't even stable
# between boots), so the install failed or GRUB went to the wrong disk.
# This runs while /target is mounted, finds the disk under the root
# partition through sysfs (works for sdX, vdX and nvmeXnY), and preseeds it.
set -e
. /usr/share/debconf/confmodule

part="$(awk '$2 == "/target" { print $1; exit }' /proc/mounts)"
part="${part#/dev/}"
[ -n "$part" ] && [ -e "/sys/class/block/$part/partition" ] || exit 0

disk="$(basename "$(readlink -f "/sys/class/block/$part/..")")"
[ -b "/dev/$disk" ] || exit 0

db_set grub-installer/bootdev "/dev/$disk"
db_fset grub-installer/bootdev seen true
logger -t nithronos-bootdev "GRUB boot device: /dev/$disk (root on /dev/$part)" 2>/dev/null || true
