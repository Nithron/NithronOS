#!/bin/bash
set -e

echo "[98-setup-installer] Setting up installer and system scripts..."

# Make installer executable if it exists
if [ -f /usr/sbin/nos-installer ]; then
    chmod +x /usr/sbin/nos-installer
else
    echo "[98-setup-installer] Warning: /usr/sbin/nos-installer not found"
fi

if [ -f /usr/lib/nos/installer-welcome ]; then
    chmod +x /usr/lib/nos/installer-welcome
else
    echo "[98-setup-installer] Warning: /usr/lib/nos/installer-welcome not found"
fi

# Enable installer welcome service
systemctl enable nos-installer-welcome.service || true

echo "[98-setup-installer] Setup complete"
