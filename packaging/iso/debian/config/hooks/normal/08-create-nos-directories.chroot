#!/bin/bash
set -e

echo "[08-create-nos-directories] Creating nOS directories..."

mkdir -p /var/lib/nos/state /var/lib/nos-update /etc/nos/update /etc/nosd /etc/apt/sources.list.d /run/nos
chmod 755 /etc/apt/sources.list.d /run/nos

# nosd runs as the nos user and owns its config and state; the nosd package
# creates the user. /etc/nos holds secrets (secret.key), so it stays private.
if id -u nos >/dev/null 2>&1; then
    chown -R nos:nos /etc/nos /etc/nosd /var/lib/nos /var/lib/nos-update
    chmod 0770 /etc/nos /etc/nosd /var/lib/nos
else
    echo "[08-create-nos-directories] Warning: nos user missing; nosd's postinst sets ownership"
fi

echo "[08-create-nos-directories] Directories created"
