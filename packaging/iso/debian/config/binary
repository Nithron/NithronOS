# live-build configuration for binary image

# Bootloaders
LB_BOOTLOADERS="grub-efi,grub-pc"

# Enable GRUB theme
LB_GRUB_SPLASH=""

# ISO options
LB_ISO_APPLICATION="nOS"
LB_ISO_PUBLISHER="nOS Project"
LB_ISO_VOLUME="nOS"

# Binary filesystem
LB_BINARY_FILESYSTEM="fat32"

# Memtest
LB_MEMTEST="memtest86+"
