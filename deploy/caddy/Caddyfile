{
  # Admin API on a socket only root and caddy can reach (reloads need it).
  admin unix//var/lib/caddy/admin.sock
  auto_https off
}

:80 {
  redir https://{host}{uri} permanent
}

:443 {
  # Apps installed by nOS (written by nos-agent)
  import /etc/caddy/Caddyfile.d/app-*.caddy

  # If you have certs on disk (recommended for IP SAN):
  tls /etc/ssl/nos/cert.pem /etc/ssl/nos/key.pem

  encode gzip zstd

  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Cross-Origin-Opener-Policy "same-origin"
    Cross-Origin-Embedder-Policy "require-corp"
    Strict-Transport-Security "max-age=31536000"
  }

  @api path /api/*
  handle @api {
    reverse_proxy 127.0.0.1:9000
  }

  handle {
    root * /usr/share/nos/web
    try_files {path} /index.html
    file_server
  }

  log {
    output file /var/log/caddy/access.log
  }
}