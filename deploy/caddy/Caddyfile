# Managed by nOS (package nos). The web interface on 443 with this machine's
# self-signed certificate (nos-certgen), nosd behind /api and /dav, and the
# installed apps under /apps/<id>/ (snippets written by nos-agent).
# Replaced on package upgrades while this first line is here; remove it to
# keep your own version.
{
  # Admin API on a socket only root and caddy can reach (reloads need it).
  admin unix//var/lib/caddy/admin.sock
  # Certificates are managed only for a public domain (Caddyfile.d/
  # site-public.caddy, from the HTTPS settings); the :80 redirect is ours.
  auto_https disable_redirects
}

# The web interface: shared by the LAN site and a public domain's site.
(nos_site) {
  # Apps installed by nOS (written by nos-agent)
  import /etc/caddy/Caddyfile.d/app-*.caddy

  encode gzip zstd

  # No Strict-Transport-Security: with a self-signed certificate it makes
  # browsers refuse the "continue anyway" a first visit needs.
  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Cross-Origin-Opener-Policy "same-origin"
    Cross-Origin-Embedder-Policy "require-corp"
  }

  # nosd: the API and WebDAV (NithronSync clients and file managers).
  @nosd path /api/* /dav /dav/*
  handle @nosd {
    reverse_proxy 127.0.0.1:9000
  }

  handle {
    root * /usr/share/nos/web
    try_files {path} /index.html
    file_server
  }

  log {
    output file /var/log/caddy/access.log
  }
}

# A public domain with a Let's Encrypt certificate, when one is set up.
import /etc/caddy/Caddyfile.d/site-*.caddy

:80 {
  redir https://{host}{uri} permanent
}

:443 {
  tls /etc/ssl/nos/cert.pem /etc/ssl/nos/key.pem
  import nos_site
}
