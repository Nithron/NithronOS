[Unit]
Description=nOS API Server (nosd)
After=network.target nos-agent.service
Wants=nos-agent.service

[Service]
# /run/nos holds the first-boot console banner; keep it across restarts
# and readable by agetty.
RuntimeDirectory=nos
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
User=nos
Group=nos
ExecStart=/usr/bin/nosd
StateDirectory=nos
ConfigurationDirectory=nos
UMask=007
StandardOutput=journal+console
StandardError=journal+console
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
KillSignal=SIGTERM
KillMode=mixed
ExecStopPost=/bin/sh -c 'sleep 0.1'
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=true
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
CapabilityBoundingSet=
LockPersonality=yes
MemoryDenyWriteExecute=yes
# AF_NETLINK: listing the network interfaces (network status).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallFilter=@system-service
# /srv (app compose files) isn't protected by ProtectSystem=full; /run/nos
# is the RuntimeDirectory.
ReadWritePaths=/etc/nos /var/lib/nos

[Install]
WantedBy=multi-user.target


