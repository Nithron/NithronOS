[Unit]
Description=nOS firewall (table inet nos)
Documentation=file:///usr/share/doc/nos-agent/
# Before the network comes up, after Debian's nftables.service (whose
# default configuration flushes the whole ruleset).
DefaultDependencies=no
Before=network-pre.target shutdown.target
Wants=network-pre.target
After=nftables.service local-fs.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/nos/nos-firewall-load
ExecReload=/usr/lib/nos/nos-firewall-load

[Install]
WantedBy=sysinit.target
