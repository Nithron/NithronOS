# OS cruft
.DS_Store
Thumbs.db

# Node / Web
node_modules/
dist/
build/
.cache/
.vite/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Go
bin/
out/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
coverage/
*.coverprofile

# Python scripts (if used)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Packages / Artifacts
*.iso
*.img
*.qcow2
*.squashfs
*.deb
*.tar
*.tar.gz
*.zip

# Packaging build dirs
packaging/**/build/
packaging/**/work/
packaging/**/output/
.packaging-cache/

# Docker (optional)
docker-data/
**/.docker-build/

# Env / Secrets
.env
.env.*
!.env.example

# Editors / IDE
.vscode/
.idea/
*.swp
*.swo
*.orig

# Misc cache/temp
tmp/
.cache/
logs/

# Build outputs (built by Makefile / debian/rules, never committed)
/agent/nos-agent/nos-agent
/backend/nosd/nosd
/cmd/nosctl/nosctl
packaging/deb/*/deb-build/
*.tsbuildinfo

# Local dev runtime state (devdata/users.json is the only tracked fixture)
devdata/*
!devdata/users.json
!devdata/snapshots.yaml
backend/nosd/**/devdata/
*.json.lock

# Generated by packaging/iso/scripts/gen-branding.sh from VERSION
packaging/iso/debian/config/includes.chroot/etc/os-release
packaging/iso/debian/config/includes.chroot/etc/issue
packaging/iso/debian/config/includes.chroot/etc/motd

# ISO build inputs generated by packaging/iso/build.sh
packaging/iso/debian/config/packages.chroot/
packaging/iso/debian/config/package-lists/nos-local.list.chroot
packaging/iso/debian/config/includes.binary/install.amd/

# Generated by backend/nosd/cmd/route-dump in CI (docs/api/openapi.json is the checked-in copy)
route_dump.json

# Live UI pass output (scripts/live-ui/run.sh)
tests/e2e/ui/test-results/
tests/e2e/ui/playwright-report/
tests/e2e/ui/live-report.json
